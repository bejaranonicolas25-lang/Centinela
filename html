<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CENTINELA</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;font-family:Arial,sans-serif}
body{background:#040d21;color:#fff;min-height:100vh}
.hidden{display:none!important}
.wrap{max-width:460px;margin:0 auto;padding:20px 14px 40px}
.hero{text-align:center;padding:20px 0 10px}
.hero .bot{font-size:80px}
.hero h1{font-size:48px;letter-spacing:4px}
.card{background:#0a1a3a;border:1px solid #38bdf8;border-radius:16px;padding:20px;margin-top:10px}
h2{text-align:center;font-size:18px;margin-bottom:14px}
.chip{display:flex;align-items:center;gap:10px;background:#020817;border:1px solid #1e3a8a;border-radius:12px;padding:12px;cursor:pointer;margin-bottom:14px}
.ava{width:38px;height:38px;border-radius:50%;background:#2563eb;display:flex;align-items:center;justify-content:center;font-weight:800}
label{display:block;font-size:13px;color:#cbd5e1;margin:10px 0 6px}
input{width:100%;background:#01040a;border:1px solid #1e3a8a;color:#fff;padding:12px;border-radius:10px;font-size:15px;outline:none}
.row{position:relative}
.row button{position:absolute;right:8px;top:50%;transform:translateY(-50%);background:#0f172a;border:1px solid #1e3a8a;color:#fff;padding:6px 10px;border-radius:8px;cursor:pointer}
.msg{padding:10px;border-radius:8px;font-size:13px;margin-top:12px;text-align:center;background:rgba(16,185,129,.2);border:1px solid #10b981;color:#6ee7b7}
.btn{width:100%;padding:14px;border-radius:10px;border:none;font-weight:800;font-size:16px;cursor:pointer;margin-top:12px}
.blue{background:#2563eb;color:#fff}
.dark{background:#020817;color:#fff;border:1px solid #1e3a8a}
.links{display:flex;justify-content:space-between;margin:14px 0}
.links button{background:none;border:none;color:#38bdf8;font-weight:700;cursor:pointer}
.dash{max-width:600px;margin:0 auto;padding:16px 14px 40px}
.top{display:flex;justify-content:space-between;align-items:center;background:#07193d;border:1px solid #38bdf8;border-radius:12px;padding:12px;margin-bottom:14px}
.box{background:#0a1a3a;border:1px solid #1e3a8a;border-radius:14px;padding:16px;margin-bottom:14px}
.box h3{margin-bottom:10px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.tile{background:#020817;border:1px solid #1e3a8a;border-radius:12px;padding:14px;text-align:center;cursor:pointer}
.tile div{font-size:26px}
.tile b{font-size:12px}
.out{background:#01040a;border:1px solid #1e3a8a;border-radius:10px;padding:12px;font-size:13px;white-space:pre-wrap;margin-top:10px;max-height:300px;overflow:auto}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.85);display:none;align-items:center;justify-content:center;padding:16px;z-index:99}
.modal.open{display:flex}
.modal .in{background:#081838;border:1px solid #38bdf8;border-radius:16px;padding:20px;width:100%;max-width:500px;max-height:85vh;overflow:auto}
.modal pre{white-space:pre-wrap;color:#cbd5e1;font-size:13px;margin-top:10px}
#toast{position:fixed;bottom:20px;right:20px;background:#071530;border:1px solid #38bdf8;padding:12px 16px;border-radius:12px;z-index:100;display:none}
</style>
</head>
<body>
<div id="toast"></div>

<div id="login" class="wrap">
<div class="hero"><div class="bot">🤖</div><h1>CENTINELA</h1><p style="color:#94a3b8;margin-top:6px">Nico Bejarano • ALFA BRAVO 10-4</p></div>
<div class="card">
<h2>Bienvenido a CENTINELA</h2>
<div class="chip" id="chip"><div class="ava">N</div><div><b>Nico Bejarano</b><br><small style="color:#94a3b8">Dueño • Tocame</small></div><div style="margin-left:auto;color:#38bdf8">›</div></div>
<label>Usuario</label>
<input id="user" value="Nico Bejarano">
<label>Contraseña</label>
<div class="row"><input id="pass" type="password" placeholder="NICO-10-4-SENTINELA"><button type="button" id="ver">👁️ Ver</button></div>
<div id="msg" class="msg hidden">✅ Listo para entrar</div>
<div class="links"><button type="button" id="olvide">¿Olvidaste tu contraseña?</button><button type="button" id="guardada">Ver cuenta guardada</button></div>
<button class="btn blue" id="entrar" onclick="entrarAhora()">Iniciar sesión - TOCAME PARA ENTRAR</button>
<p style="text-align:center;color:#94a3b8;font-size:12px;margin:12px 0">o</p>
<button class="btn dark" id="google" onclick="guardarGoogle()">G Continuar con Google</button>
<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px"><button class="btn dark" onclick="modalShow('Crear cuenta nueva','Solo Nico puede crear cuentas.\n\nUsuario: Nico Bejarano\nClave: NICO-10-4-SENTINELA')">Crear cuenta nueva</button><button class="btn dark" onclick="entrarAhora()">Modo offline</button></div>
<p style="text-align:center;color:#64748b;font-size:12px;margin-top:16px">© 2026 CENTINELA - José León Suárez<br>Si tocás Iniciar sesión, entrás sí o sí.</p>
</div>
</div>

<div id="panel" class="dash hidden">
<div class="top"><b>🛡️ CENTINELA • YA ENTRASTE ✅</b><span><span id="nom">Nico</span> • <button onclick="salirAhora()" style="background:none;border:none;color:#38bdf8;font-weight:700;cursor:pointer">Salir</button></span></div>
<div class="box"><h3>🌤️ Clima real - Tigre</h3><p id="clima">Cargando...</p><button class="btn blue" onclick="clima()">🔄 Actualizar clima</button></div>
<div class="box"><h3>🔊 Voz real</h3><button class="btn blue" onclick="hablar('Alfa Bravo diez cuatro, Centinela activo, Nico Bejarano')">▶️ ESCUCHAR: CENTINELA ACTIVO</button><button class="btn dark" onclick="pararVoz()">⏹️ Parar voz</button><label style="display:block;margin:10px 0 6px">Tu texto</label><input id="vozTxt" value="Alfa Bravo 10-4, Centinela activo, Nico Bejarano"><button class="btn blue" onclick="hablar(document.getElementById('vozTxt').value)">🗣️ Decir mi texto</button></div>
<div class="box"><h3>📚 Traductor real</h3><input id="tradIn" placeholder="Escribí: amparo, taquicardia, penal, asado"><button class="btn blue" onclick="traducir()">TRADUCIR</button><div id="tradOut" class="out hidden"></div></div>
<div class="box"><h3>🏭 Fábrica real</h3><button class="btn blue" onclick="generar()">GENERAR 10 ORACIONES</button><button class="btn dark" onclick="verGuardadas()">📋 Ver guardadas</button><button class="btn dark" onclick="descargar()">⬇️ Descargar .txt real</button><div id="genOut" class="out hidden"></div></div>
<div class="box"><h3>💬 Diálogo real</h3><input id="t1" value="SALUDO"><input id="t2" value="PREGUNTA"><button class="btn blue" onclick="dialogo()">CREAR DIÁLOGO</button><div id="diaOut" class="out hidden"></div></div>
<div class="box"><h3>✅ Corrector real</h3><input id="corIn" placeholder="Ej: {#☠️.} [Amparo + Taquicardia]"><button class="btn blue" onclick="corregir()">CORREGIR</button><div id="corOut" class="out hidden"></div></div>
<div class="box"><h3>🛠️ 20 Herramientas reales</h3><input id="buscar" placeholder="Buscar... ej: dolar, clima, juego" oninput="filtrar()"><div class="grid" id="grid"></div></div>
</div>

<div id="modal" class="modal"><div class="in"><h3 id="mTit">CENTINELA</h3><p id="mTxt" style="color:#cbd5e1;font-size:14px;white-space:pre-wrap"></p><pre id="mPre" style="display:none"></pre><button class="btn blue" onclick="cerrarModal()">Cerrar</button><button class="btn dark" onclick="copiarModal()">📋 Copiar</button></div></div>

<script>
function toast(t){var e=document.getElementById('toast');e.textContent=t;e.style.display='block';setTimeout(function(){e.style.display='none'},3000);}
function modalShow(t,txt,pre){document.getElementById('mTit').textContent=t;document.getElementById('mTxt').textContent=txt||'';var p=document.getElementById('mPre');if(pre){p.style.display='block';p.textContent=pre;}else{p.style.display='none';}document.getElementById('modal').classList.add('open');}
function cerrarModal(){document.getElementById('modal').classList.remove('open');}
function copiarModal(){var t=document.getElementById('mTxt').textContent;if(navigator.clipboard)navigator.clipboard.writeText(t).then(function(){toast('✅ Copiado');});}
document.getElementById('modal').onclick=function(e){if(e.target===this)this.classList.remove('open');};
// ESTA ES LA CLAVE: ENTRAR SIEMPRE, SIN REVISAR CLAVE
function entrarAhora(){
var u=document.getElementById('user').value||'Nico Bejarano';
document.getElementById('nom').textContent=u;
document.getElementById('login').style.display='none';
document.getElementById('panel').style.display='block';
document.getElementById('panel').classList.remove('hidden');
toast('✅ Bienvenido, '+u+' - Ya entraste');
clima();
window.scrollTo(0,0);
}
function salirAhora(){document.getElementById('panel').style.display='none';document.getElementById('login').style.display='block';}
function guardarGoogle(){var u=document.getElementById('user').value||'Nico Bejarano';try{localStorage.setItem('centinela_user',u);}catch(e){}document.getElementById('msg').classList.remove('hidden');document.getElementById('msg').textContent='✅ Guardada con Google: '+u+'. Ahora tocá Iniciar sesión.';toast('✅ Guardada con Google');}
document.getElementById('ver').onclick=function(){var p=document.getElementById('pass');if(p.type==='password'){p.type='text';this.textContent='🙈 Ocultar';}else{p.type='password';this.textContent='👁️ Ver';}};
document.getElementById('chip').onclick=function(){document.getElementById('user').value='Nico Bejarano';document.getElementById('pass').value='NICO-10-4-SENTINELA';document.getElementById('pass').type='text';document.getElementById('ver').textContent='🙈 Ocultar';document.getElementById('msg').classList.remove('hidden');document.getElementById('msg').textContent='✅ Cuenta Nico lista. Tocá Iniciar sesión.';};
document.getElementById('olvide').onclick=function(){modalShow('¿Olvidaste tu contraseña?','Tu clave es:\n\nNICO-10-4-SENTINELA\n\nPero igual entrás tocando Iniciar sesión, no te frena.');};
document.getElementById('guardada').onclick=function(){var s='';try{s=localStorage.getItem('centinela_user');}catch(e){}modalShow('Cuenta guardada','Guardado en este celu:\n\n'+(s||'Todavía no hay. Tocá Continuar con Google.'));};
document.getElementById('pass').addEventListener('keydown',function(e){if(e.key==='Enter')entrarAhora();});
async function clima(){try{var r=await fetch('https://api.open-meteo.com/v1/forecast?latitude=-34.47&longitude=-58.63&current=temperature_2m,relative_humidity_2m,wind_speed_10m&timezone=America%2FArgentina%2FBuenos_Aires');var j=await r.json();document.getElementById('clima').textContent='Tigre ahora: '+j.current.temperature_2m+'°C • Humedad: '+j.current.relative_humidity_2m+'% • Viento: '+j.current.wind_speed_10m+' km/h • '+new Date().toLocaleTimeString('es-AR');}catch(e){document.getElementById('clima').textContent='Sin internet ahora.';}}
function hablar(t){try{speechSynthesis.cancel();var u=new SpeechSynthesisUtterance(t);u.lang='es-AR';speechSynthesis.speak(u);}catch(e){}}
function pararVoz(){try{speechSynthesis.cancel();}catch(e){}}
var D={'amparo':'PELIGRO, NO VENGAN','cautelar':'QUEDARSE EN BASE','expediente':'JUNTA SECRETA','sentencia firme':'TODO BIEN, CERRADO','apelación':'CAMBIAR DE CÓDIGO','perito':'HAY ALGUIEN MIRANDO','testigo':'HAY INFILTRADO','fiscal':'NOS SIGUEN','defensor':'ES DE CONFIANZA','embargo':'SALIR, SIN NADA','habeas corpus':'SALIR YA','taquicardia':'PELIGRO TOTAL','hipertensión':'NOS VIGILAN','fiebre':'ZONA CALIENTE, NO VAYAS','penal':'EMERGENCIA, ACTUAR YA','asado':'JUNTA GRANDE','empanada':'PAQUETE SECRETO','mate':'HABLAR TRANQUI','gol':'LO LOGRAMOS','var':'REVISAR, ALGUIEN MIENTE','cancha':'BASE','contraseña':'CLAVE SECRETA, SOLO NICO','el tío':'NO ES DE CONFIANZA','artigas':'NO NOS VEMOS, TRAMPA','lacroze':'PELIGRO, VENGAN','sarmiento':'BUSCAR ALGO IMPORTANTE'};
function show(id,txt){var e=document.getElementById(id);e.textContent=txt;e.classList.remove('hidden');}
function traducir(){var v=(document.getElementById('tradIn').value||'').toLowerCase();var r=[];Object.keys(D).forEach(function(k){if(v.indexOf(k)>-1)r.push(k+' = '+D[k]);});show('tradOut',r.length?r.join('\n'):'Probá: amparo, taquicardia, penal, asado');}
function crearO(){var k=Object.keys(D);var a=k[Math.floor(Math.random()*k.length)],b=k[Math.floor(Math.random()*k.length)],c=k[Math.floor(Math.random()*k.length)];return 'א {#☠️.} ['+a+' + '+b+' + '+c+'] ☠️ ...---... [Artigas 99999]\nREAL: '+D[a]+' + '+D[b]+' + '+D[c];}
function getG(){try{return JSON.parse(localStorage.getItem('centinela_oraciones')||'[]');}catch(e){return[];}}
function generar(){var g=getG();var t='';for(var i=0;i<10;i++){var o=crearO();g.push(o);t+=o+'\n\n';}try{localStorage.setItem('centinela_oraciones',JSON.stringify(g));}catch(e){}show('genOut',t+'TOTAL: '+g.length);}
function verGuardadas(){var g=getG();show('genOut',g.length?g.join('\n\n'):'Todavía no hay. Tocá GENERAR.');}
function descargar(){var g=getG();var blob=new Blob([g.join('\n\n')||'Sin oraciones'],{type:'text/plain'});var a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='centinela.txt';a.click();}
var EJ={'SALUDO':'HOLA, EMPEZAMOS','PREGUNTA':'¿ALGUIEN MIENTE?','RESPUESTA':'SÍ, ALGUIEN MIENTE','PEDIDO':'NECESITO AYUDA','ORDEN':'CAMBIAR TODO YA','AVISO':'PELIGRO TOTAL','CHISTE':'CHISTE CENTINELA','DESPEDIDA':'TERMINÓ, LO LOGRAMOS'};
function dialogo(){var a=(document.getElementById('t1').value||'SALUDO').toUpperCase(),b=(document.getElementById('t2').value||'PREGUNTA').toUpperCase();show('diaOut','A - '+a+': '+(EJ[a]||a)+'\nB - '+b+': '+(EJ[b]||b));}
function corregir(){var v=document.getElementById('corIn').value||'';var e=[];if(v.indexOf('  ')>-1)e.push('Doble espacio');if(v.indexOf('א')===-1)e.push('Falta א al inicio');show('corOut',e.length?'ERRORES:\n- '+e.join('\n- '):'✅ CORRECTA:\n'+v);}
var T=[['🛡️','CENTINELA'],['🔐','VAULT'],['🧠','ACCORDED'],['🗣️','HABLA'],['☁️','CLOUD'],['📓','CHECKBOOK'],['⚙️','SETTINGS'],['📄','OFFICE'],['📤','SHARE'],['💻','CODE'],['🎓','ACADEMY'],['🎮','PLAY'],['📈','TRADER'],['📅','CALENDARIO'],['🧮','CALCULADORA'],['📷','CÁMARA'],['📍','UBICACIÓN'],['🔔','NOTIFICACIÓN'],['💾','GUARDAR'],['🗑️','BORRAR']];
var grid=document.getElementById('grid');
T.forEach(function(x){var d=document.createElement('div');d.className='tile';d.setAttribute('data-n',x[1].toLowerCase());d.innerHTML='<div>'+x[0]+'</div><b>'+x[1]+'</b>';d.onclick=function(){
if(x[1]==='HABLA')hablar('Centinela Habla, sistema real');
else if(x[1]==='CLOUD')clima();
else if(x[1]==='OFFICE')descargar();
else if(x[1]==='SHARE'){if(navigator.share)navigator.share({title:'CENTINELA',text:'CENTINELA de Nico',url:location.href});}
else if(x[1]==='CODE')modalShow('Código real','Código de esta página:',document.documentElement.outerHTML.slice(0,4000));
else if(x[1]==='ACADEMY')modalShow('Academy','NIVEL 1: 1 mes - 1 palabra\nNIVEL 2: 3 meses - 2 palabras\nNIVEL 3: 6 meses - 3 palabras + Morse\nNIVEL 4: 1 año - Todo\nNIVEL 5: 2 AÑOS - Todo + Puntuación + Universal + Aleph');
else if(x[1]==='PLAY'){var ks=Object.keys(D);var k=ks[Math.floor(Math.random()*ks.length)];var r=prompt('¿Qué significa: '+k+' ?');if(r!==null)modalShow('Juego',r.toLowerCase()===D[k].toLowerCase()?'✅ CORRECTO: '+D[k]:'❌ Era: '+D[k]);}
else if(x[1]==='TRADER'){fetch('https://dolarapi.com/v1/dolares/blue').then(function(res){return res.json();}).then(function(j){modalShow('Dólar Blue real','Compra: $'+j.compra+'\nVenta: $'+j.venta);}).catch(function(){modalShow('Dólar','Sin internet ahora.');});}
else if(x[1]==='CALENDARIO')modalShow('Fecha real',new Date().toLocaleString('es-AR'));
else if(x[1]==='CALCULADORA')modalShow('Cuenta real','120 x 2 = '+(120*2));
else if(x[1]==='CÁMARA'){var inp=document.createElement('input');inp.type='file';inp.accept='image/*';inp.capture='environment';inp.onchange=function(){toast('✅ Foto capturada');};inp.click();}
else if(x[1]==='UBICACIÓN'){if(navigator.geolocation)navigator.geolocation.getCurrentPosition(function(p){modalShow('Ubicación real','Lat: '+p.coords.latitude+'\nLon: '+p.coords.longitude);},function(){modalShow('Ubicación','No diste permiso.');});}
else if(x[1]==='NOTIFICACIÓN'){if('Notification' in window){Notification.requestPermission().then(function(per){if(per==='granted')new Notification('CENTINELA REAL',{body:'Alfa Bravo 10-4, Nico'});});}}
else if(x[1]==='GUARDAR'){try{localStorage.setItem('centinela_manual','Guardado '+new Date().toLocaleString('es-AR'));}catch(e){}toast('✅ Guardado');}
else if(x[1]==='BORRAR'){if(confirm('¿Borrar oraciones?')){try{localStorage.removeItem('centinela_oraciones');}catch(e){}toast('✅ Borrado');}}
else if(x[1]==='VAULT')modalShow('Bóveda','Oraciones: '+getG().length);
else if(x[1]==='CHECKBOOK')modalShow('Cuaderno','Tenés '+getG().length+' oraciones.');
else if(x[1]==='SETTINGS')modalShow('Config','Usuario: Nico\nOnline: '+navigator.onLine);
else if(x[1]==='ACCORDED'){var q=prompt('Preguntale a ACCORDED (ej: amparo)');if(q)modalShow('ACCORDED','Diccionario: '+(D[q.toLowerCase()]||'No está. Probá: amparo, penal, asado'));}
else modalShow(x[1],'Función real activada.');
};grid.appendChild(d);});
function filtrar(){var q=document.getElementById('buscar').value.toLowerCase();document.querySelectorAll('.tile').forEach(function(el){el.style.display=el.getAttribute('data-n').indexOf(q)>-1?'block':'none';});}
clima();
</script>
</body>
</html>
